# ── Product Intelligence (PI Admin) — ตัวอย่างค่าตั้งแวดล้อม ──
# คัดลอกเป็น .env แล้วเติมค่าจริง (ไฟล์ .env ถูก git-ignore)

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ใช้กับ supabase CLI (db push / inspect) เท่านั้น — ไม่ต้องใส่ถ้าใช้ --remote=<url>
DATABASE_URL=
DATABASE_PASSWORD=
# db.<ref>.supabase.co เป็น IPv6-only บนเครื่องที่ต่อ IPv4 อย่างเดียวให้ใช้ pooler
# (npm run db:push หาภูมิภาคให้เอง แต่ระบุไว้จะเร็วขึ้น)
# SUPABASE_POOLER_REGION=ap-southeast-1

# ── AI Enrichment (DeepSeek / OpenAI-compatible) ────────────
# เปิดใช้งาน: ใส่ AI_API_KEY แล้ว restart dev server (Next อ่าน .env ตอน start)
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-flash
# AI_BASE_URL=https://api.deepseek.com
# AI_THINKING=disabled          # enabled = ใช้ reasoning (ช้ากว่า/แพงกว่า แต่ลึกกว่า)
# AI_MAX_TOKENS=1500
# AI_BATCH_SIZE=10
# AI_CONCURRENCY=3
# AI_TIMEOUT_MS=30000
# AI_TEMPERATURE=0
# AI_JSON_MODE=1
# AI_USER_ID=pi-admin
# AI_ENRICH=0                   # ปิด AI ทั้งหมด
# AI_GATE_MIN_FIELDS=2          # ข้าม AI เมื่อกฎตีความได้ ≥ N กลุ่ม (0 = ไม่ข้าม)
# AI_FOCUS_AI_ONLY=1            # แถวที่ถูกข้าม ยังขอเฉพาะค่าที่กฎสร้างไม่ได้ (แพงขึ้น)
# PHRASE_MEMORY=0               # ปิดพจนานุกรมวลี (จะเรียก AI ทุกแถว)

# ── Vision (อ่านภาพสินค้าด้วย VLM) ──────────────────────────
# DeepSeek อ่านภาพได้เองตั้งแต่ v4-flash-vision และตอนนี้รวมอยู่ใน `deepseek-flash`
# → ใช้ AI_API_KEY เดิมได้เลย ไม่ต้องมี key แยก (เว้น VISION_API_KEY ว่างไว้)
# จะใช้เจ้าอื่น (OpenAI / Gemini compat / OpenRouter / Qwen-VL) ก็ใส่ key แยกได้
# VISION_PROVIDER=deepseek      # deepseek | openai | compatible (ไม่ใส่ = ตาม AI_PROVIDER)
VISION_API_KEY=
# VISION_BASE_URL=https://api.deepseek.com
# VISION_MODEL=deepseek-flash
# VISION_THINKING=0             # 0 = ปิด reasoning (จำเป็นสำหรับ DeepSeek ไม่งั้น max_tokens หมดไปกับ thinking)
# VISION_DETAIL=low             # low = ย่อเป็น 512×512 (~85–190 token/รูป) ถูกสุด
# VISION_MAX_TOKENS=1600        # เผื่อไว้ให้ reasoning ในกรณีเปิด thinking
# VISION_MAX_IMAGES=1           # จำนวนรูปต่อสินค้า (1 = หน้าปกเท่านั้น)
# VISION_MAX_PER_RUN=25         # เพดานจำนวนสินค้าต่อรอบ
# VISION_CONCURRENCY=2
# VISION_TIMEOUT_MS=45000
# VISION_MAX_IMAGE_BYTES=2000000
# VISION_IMAGE_MODE=url         # url = ให้ผู้ให้บริการดึงรูปเอง, data = ดาวน์โหลดแล้วส่ง base64
# VISION_JSON_MODE=1
# VISION_ENRICH=0               # ปิดการอ่านภาพทั้งหมด
# VISION_COST_INPUT_PER_M=0.15  # ไม่ใส่ = ใช้ราคา DeepSeek flash อัตโนมัติ
# VISION_COST_OUTPUT_PER_M=0.6

# ── Background pipeline (หลัง ingestion) ────────────────────
# AUTO_PIPELINE=0               # ปิดงานเบื้องหลัง (normalize/enrichment/audit/DB sync)

# ── (เดิม) optional: auth ของ ingest ────────────────────────
# PI_INGEST_API_KEY=
